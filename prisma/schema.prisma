generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
}

enum RecommendationAction {
  INCREASE
  DECREASE
  HOLD
}

enum UserRole {
  ADMIN
  USER
}

enum HotelRole {
  OWNER
  MANAGER
  ANALYST
  VIEWER
}

model User {
  id                     Int               @id @default(autoincrement())
  email                  String            @unique
  name                   String
  passwordHash           String
  role                   UserRole          @default(USER)
  active                 Boolean           @default(true)
  emailVerified          Boolean           @default(false)
  emailVerificationToken String?           @unique
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  memberships            HotelMembership[]

  @@index([email])
}

model HotelMembership {
  id        Int       @id @default(autoincrement())
  userId    Int
  hotelId   Int
  role      HotelRole @default(VIEWER)
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel     Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([userId, hotelId])
  @@index([hotelId])
  @@index([userId, isDefault])
}

model Hotel {
  id              Int                      @id @default(autoincrement())
  code            String                   @unique
  name            String
  totalRooms      Int
  currency        String                   @default("MXN")
  timezone        String                   @default("America/Mexico_City")
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  reservations    ReservationRaw[]
  dailyMetrics    DailyMetrics[]
  marketRates     MarketRates[]
  competitors     Competitor[]
  alerts          Alerts[]
  recommendations Recommendations[]
  crsSnapshots    CrsRoomRateDistributionSnapshot[]
  rateShopSnapshots RateShopSnapshot[]
  recommendationSettings RecommendationSettings?
  memberships     HotelMembership[]
  inviteCodes     HotelInviteCode[]
  ratePlanImports RatePlanImport[]
  ratePlans       RatePlan[]

  @@index([name])
}

model RatePlanImport {
  id               Int        @id @default(autoincrement())
  hotelId          Int
  sourceFile       String
  sourceBrand      String?
  importedAt       DateTime   @default(now())
  rowsParsed       Int        @default(0)
  ratePlansUpserted Int       @default(0)
  sheetSummary     Json?
  hotel            Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  ratePlans        RatePlan[]

  @@index([hotelId, importedAt])
}

model RatePlan {
  id                           Int             @id @default(autoincrement())
  hotelId                      Int
  importId                     Int
  code                         String
  name                         String
  region                       String?
  country                      String?
  sourceBrand                  String?
  rateCategory                 String?
  rateType                     String?
  redemptionType               String?
  marketSegment                String?
  pricingStandard              String?
  participationRequirement     String?
  derivedFromCode              String?
  derivedFormula               String?
  roomTypeStandard             String?
  mirrorPoolAssignment         String?
  additionalInformation        String?
  descriptionShort             String?
  descriptionLong              String?
  pmsCode                      String?
  pmsGroupCode                 String?
  gdsCategory                  String?
  sourceAssignment             String?
  comparisonType               String?
  targetRateType               String?
  inventoryRequired            Int?
  sellLimit                    Int?
  minStayThru                  Int?
  maxStayThru                  Int?
  minLeadDays                  Int?
  maxLeadDays                  Int?
  discountMin                  Decimal?        @db.Decimal(10, 2)
  discountMax                  Decimal?        @db.Decimal(10, 2)
  defaultDiscountRecommendation Decimal?       @db.Decimal(10, 2)
  deriveOffsetAmount           Decimal?        @db.Decimal(10, 2)
  adjustmentAmount             Decimal?        @db.Decimal(10, 2)
  rewardsQualifying            Boolean?
  mandatory                    Boolean?
  manageInCrsOnly              Boolean?
  commissionable               Boolean?
  lra                          Boolean?
  channels                     Json?
  rawAbbreviated               Json?
  rawDefined                   Json?
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt
  hotel                        Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  import                       RatePlanImport  @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([hotelId, code])
  @@index([hotelId, marketSegment])
  @@index([hotelId, pricingStandard])
  @@index([hotelId, derivedFromCode])
  @@index([hotelId, importId])
}

model HotelInviteCode {
  id              Int       @id @default(autoincrement())
  hotelId         Int
  code            String    @unique
  role            HotelRole @default(VIEWER)
  label           String?
  active          Boolean   @default(true)
  expiresAt       DateTime?
  uses            Int       @default(0)
  maxUses         Int?
  createdByUserId Int?
  createdAt       DateTime  @default(now())
  hotel           Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
}

model RecommendationSettings {
  id                     Int      @id @default(autoincrement())
  hotelId                Int      @unique
  highOccupancyThreshold Decimal  @db.Decimal(5, 2)
  lowOccupancyThreshold  Decimal  @db.Decimal(5, 2)
  significantDiffPct     Decimal  @db.Decimal(6, 2)
  demandWeight           Decimal  @db.Decimal(6, 4)
  marketWeight           Decimal  @db.Decimal(6, 4)
  maxAdjustmentPct       Decimal  @db.Decimal(6, 2)
  minActionStepPct       Decimal  @db.Decimal(6, 2)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  hotel                  Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, updatedAt])
}

model RateShopSnapshot {
  id             Int      @id @default(autoincrement())
  hotelId        Int
  competitorName String
  source         String
  checkInDate    DateTime
  checkOutDate   DateTime
  adults         Int      @default(2)
  price          Decimal  @db.Decimal(10, 2)
  currency       String
  available      Boolean  @default(true)
  scrapedAt      DateTime @default(now())
  createdAt      DateTime @default(now())
  hotel          Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, checkInDate, scrapedAt])
  @@index([hotelId, competitorName, checkInDate])
  @@index([hotelId, source, checkInDate])
}

model ReservationRaw {
  id                    Int       @id @default(autoincrement())
  hotelId               Int
  reservationExternalId String
  bookingDate           DateTime
  arrivalDate           DateTime
  departureDate         DateTime?
  nights                Int       @default(1)
  noOfRooms             Int       @default(1)
  roomRate              Decimal   @db.Decimal(10, 2)
  sourceStatus          String?
  sourceUser            String?
  rawPayload            Json?
  createdAt             DateTime  @default(now())
  hotel                 Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, reservationExternalId])
  @@index([hotelId, arrivalDate])
  @@index([hotelId, bookingDate])
}

model DailyMetrics {
  id          Int      @id @default(autoincrement())
  hotelId     Int
  date        DateTime
  bookedRooms Int      @default(0)
  occupancy   Decimal  @db.Decimal(5, 2)
  adr         Decimal  @db.Decimal(10, 2)
  revenue     Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, date])
  @@index([hotelId, date])
  @@index([date])
}

model MarketRates {
  id                Int                     @id @default(autoincrement())
  hotelId           Int
  date              DateTime
  yourPrice         Decimal?                @db.Decimal(10, 2)
  marketAverage     Decimal?                @db.Decimal(10, 2)
  sourceFile        String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  hotel             Hotel                   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  competitorRates   CompetitorMarketRates[]
  recommendations   Recommendations[]

  @@unique([hotelId, date])
  @@index([hotelId, date])
}

model Competitor {
  id          Int                     @id @default(autoincrement())
  hotelId     Int
  name        String
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  hotel       Hotel                   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  marketRates CompetitorMarketRates[]

  @@unique([hotelId, name])
  @@index([hotelId])
}

model CompetitorMarketRates {
  id           Int        @id @default(autoincrement())
  competitorId Int
  marketRateId Int
  price        Decimal    @db.Decimal(10, 2)
  createdAt    DateTime   @default(now())
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  marketRate   MarketRates @relation(fields: [marketRateId], references: [id], onDelete: Cascade)

  @@unique([competitorId, marketRateId])
  @@index([marketRateId])
  @@index([competitorId])
}

model Recommendations {
  id             Int                  @id @default(autoincrement())
  hotelId        Int
  marketRateId   Int?
  date           DateTime
  action         RecommendationAction
  suggestedPrice Decimal              @db.Decimal(10, 2)
  explanation    String
  occupancy      Decimal?             @db.Decimal(5, 2)
  yourPrice      Decimal?             @db.Decimal(10, 2)
  marketAverage  Decimal?             @db.Decimal(10, 2)
  priceDiffPct   Decimal?             @db.Decimal(6, 2)
  demandFactor   Decimal?             @db.Decimal(6, 4)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  hotel          Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  marketRate     MarketRates?         @relation(fields: [marketRateId], references: [id], onDelete: SetNull)
  alerts         Alerts[]

  @@unique([hotelId, date])
  @@index([hotelId, date])
  @@index([action])
}

model Alerts {
  id               Int           @id @default(autoincrement())
  hotelId          Int
  recommendationId Int?
  date             DateTime
  type             String
  severity         AlertSeverity
  title            String
  message          String
  resolved         Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  hotel            Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  recommendation   Recommendations? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)

  @@unique([hotelId, date, type])
  @@index([hotelId, date, resolved])
  @@index([severity, resolved])
}

model CrsRoomRateDistributionSnapshot {
  id                    Int      @id @default(autoincrement())
  hotelId               Int
  sourceFile            String
  criteriaStartDate     DateTime
  criteriaEndDate       DateTime
  criteriaWhichDate     String
  criteriaShowGroups    String   @default("NOT SPECIFIED")
  criteriaCurrency      String?
  criteriaSections      String?
  criteriaChannels      String?
  criteriaUserLogin     String?
  reportExecutionTime   DateTime?
  totalReservationCount Int
  totalRoomNights       Int
  totalRevenue          Decimal  @db.Decimal(14, 2)
  totalAdr              Decimal  @db.Decimal(10, 2)
  sourceTotalLabel      String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  hotel                 Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, criteriaStartDate, criteriaEndDate, criteriaWhichDate, criteriaShowGroups])
  @@index([hotelId, criteriaStartDate, criteriaEndDate])
  @@index([hotelId, reportExecutionTime])
}
